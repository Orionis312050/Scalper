# Copie ce fichier en .env (déjà dans .gitignore) et renseigne tes valeurs.
# Ne jamais committer de vraie clé API.

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Port hôte publié par docker-compose (le conteneur interne reste sur 8000).
# Décommente et change si le port est déjà occupé sur le serveur de déploiement :
# SCALPER_HOST_PORT=8000

# Moteur d'inpainting pour la suppression du texte dans les images (simple|lama|auto, défaut auto).
# lama = big-lama (advimman/lama) en ONNX, téléchargé une fois (~208 Mo) dans SCALPER_LAMA_CACHE.
# SCALPER_INPAINT_ENGINE=lama
# Tier PP-OCRv6 pour l'OCR paddle (défaut medium ; tiny ne lit pas le japonais) :
# SCALPER_PADDLE_OCR_TIER=medium
# Doc unwarping/orientation PaddleOCR 3.7 (faussent les coordonnées des boîtes sur pages manga) :
# SCALPER_PADDLE_DOC_UNWARP=0
# SCALPER_PADDLE_DOC_ORIENT=0
# Seuils de détection (défauts 0.5 / 2.0, plus souples que les défauts PaddleOCR 0.6 / 1.5) :
# SCALPER_PADDLE_DET_BOX_THRESH=0.5
# SCALPER_PADDLE_DET_UNCLIP=2.0
# GPU (image Dockerfile.gpu + docker-compose.gpu.yml, hôte NVIDIA + nvidia-ctk) :
# SCALPER_PADDLE_DEVICE=gpu:0
# SCALPER_LAMA_DEVICE=gpu

# Valeurs par défaut du run (pré-remplies dans l'UI, utilisées par POST /run et `scalper run`) :
# SCALPER_DEFAULT_SOURCE=mangadex
# SCALPER_DEFAULT_SERIES=<id-série>
# SCALPER_DEFAULT_LANG=fr
# SCALPER_DEFAULT_SRC_LANG=en
# SCALPER_DEFAULT_OCR_ENGINE=paddle      # moteur OCR affiché (paddle = PP-OCRv6)
# SCALPER_DEFAULT_INPAINT_ENGINE=lama    # moteur d'inpainting affiché (big-lama)
# SCALPER_ZIP_EXPORT=true
# SCALPER_ZIP_INCLUDE_CLEAN=true         # embarque cleaned/ (images nettoyées) dans le zip
# SCALPER_LAMA_CACHE=/app/data/.lama
# SCALPER_LAMA_MODEL=/chemin/vers/lama_fp32.onnx   # modèle local, si déjà téléchargé ailleurs

# Environnement : dev|prod (défaut prod). En dev (SCALPER_ENV=dev), l'export zip est
# remplacé par un dossier horodaté out/export-<date>-<heure>-<minutes>/ (out/ conservé),
# uploadé vers Google Drive si un token est renseigné ci-dessous :
# SCALPER_ENV=dev
# GOOGLE_DRIVE_ACCESS_TOKEN=             # token OAuth Google Drive (scope drive.file) — jamais committé
# GOOGLE_DRIVE_PARENT_ID=                # id du dossier Drive parent (défaut : racine)
# GOOGLE_DRIVE_PARENT_NAME=Scalper       # ou nom du dossier parent (résolu en id à l'upload ; défaut : racine)
