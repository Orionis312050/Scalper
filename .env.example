# Copie ce fichier en .env (déjà dans .gitignore) et renseigne tes valeurs.
# Ne jamais committer de vraie clé API.

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Port hôte publié par docker-compose (le conteneur interne reste sur 8000).
# Décommente et change si le port est déjà occupé sur le serveur de déploiement :
# SCALPER_HOST_PORT=8000

# Moteur d'inpainting pour la suppression du texte dans les images (simple|lama|auto, défaut auto).
# lama = big-lama (advimman/lama) en ONNX, téléchargé une fois (~208 Mo) dans SCALPER_LAMA_CACHE.
# SCALPER_INPAINT_ENGINE=lama
# SCALPER_LAMA_CACHE=/app/data/.lama
# SCALPER_LAMA_MODEL=/chemin/vers/lama_fp32.onnx   # modèle local, si déjà téléchargé ailleurs
